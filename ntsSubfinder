#!/usr/bin/env python3
# -*- coding: utf-8 -*-
ntsSubfinder - Passive subdomain enumerator (no API keys required)


import argparse
import requests
import socket
import json
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from urllib.parse import urlparse
from datetime import datetime

VERSION = "1.0"

# Simple colors for terminal
class C:
    RESET = "\033[0m"
    GREEN = "\033[92m"
    YELLOW = "\033[93m"
    RED = "\033[91m"
    BLUE = "\033[94m"

def norm_domain(d):
    if d.startswith("http://") or d.startswith("https://"):
        return urlparse(d).netloc
    return d.strip().rstrip(".")

def provider_crtsh(domain, timeout=10):
    \"\"\"Query crt.sh JSON output\"\"\"
    subs = set()
    try:
        q = f"https://crt.sh/?q=%25.{domain}&output=json"
        r = requests.get(q, timeout=timeout)
        if r.status_code == 200:
            data = r.json()
            for item in data:
                name = item.get("name_value")
                if name:
                    for line in name.splitlines():
                        line = line.strip()
                        if line:
                            if line.endswith("."):
                                line = line[:-1]
                            subs.add(line)
    except Exception:
        pass
    return subs

def provider_bufferover(domain, timeout=10):
    \"\"\"Query Bufferover (dns.bufferover.run)\"\"\"
    subs = set()
    try:
        q = f"https://dns.bufferover.run/dns?q=.{domain}"
        r = requests.get(q, timeout=timeout)
        if r.status_code == 200:
            data = r.json()
            for k in ("FDNS_A","RDNS","Result"):
                if k in data and data[k]:
                    for entry in data[k]:
                        if isinstance(entry, str):
                            if "," in entry:
                                parts = entry.split(",")
                                host = parts[-1].strip()
                            else:
                                host = entry.strip()
                            if host.endswith("."):
                                host = host[:-1]
                            if host:
                                subs.add(host)
    except Exception:
        pass
    return subs

def provider_threatcrowd(domain, timeout=10):
    \"\"\"Query ThreatCrowd public API\"\"\"
    subs = set()
    try:
        q = f"https://www.threatcrowd.org/searchApi/v2/domain/report/?domain={domain}"
        r = requests.get(q, timeout=timeout)
        if r.status_code == 200:
            data = r.json()
            for s in data.get("subdomains", []):
                if s:
                    subs.add(s)
    except Exception:
        pass
    return subs

def provider_certspotter(domain, timeout=10):
    \"\"\"Query Certspotter public API (no key)\"\"\"
    subs = set()
    try:
        q = f"https://api.certspotter.com/v1/issuances?domain={domain}&include_subdomains=true&expand=dns_names"
        r = requests.get(q, timeout=timeout)
        if r.status_code == 200:
            data = r.json()
            for item in data:
                dns_names = item.get("dns_names", []) or []
                for name in dns_names:
                    if name.endswith("."):
                        name = name[:-1]
                    subs.add(name)
    except Exception:
        pass
    return subs

PROVIDERS = [
    ("crtsh", provider_crtsh),
    ("bufferover", provider_bufferover),
    ("threatcrowd", provider_threatcrowd),
    ("certspotter", provider_certspotter),
]

def gather(domain, threads=10, timeout=10, silent=False):
    results = set()
    details = {}
    with ThreadPoolExecutor(max_workers=min(len(PROVIDERS), threads)) as ex:
        future_map = {ex.submit(fn, domain, timeout): name for name, fn in PROVIDERS}
        for fut in as_completed(future_map):
            name = future_map[fut]
            try:
                res = fut.result()
                details[name] = {"count": len(res)}
                results.update(res)
                if not silent:
                    print(f"{C.BLUE}[*]{C.RESET} {name}: found {len(res)} entries")
            except Exception as e:
                details[name] = {"error": str(e)}
                if not silent:
                    print(f"{C.RED}[-]{C.RESET} {name}: error {e}")
    return results, details

def save_output(outpath, subs, fmt="text"):
    subs_list = sorted(subs)
    if fmt == "json":
        payload = {"generated_at": datetime.utcnow().isoformat()+"Z", "count": len(subs_list), "subdomains": subs_list}
        with open(outpath, "w", encoding="utf-8") as f:
            json.dump(payload, f, indent=2)
    else:
        with open(outpath, "w", encoding="utf-8") as f:
            for s in subs_list:
                f.write(s + "\n")

def main():
    parser = argparse.ArgumentParser(prog="ntsSubfinder", description="Passive subdomain enumerator (no API keys required)")
    parser.add_argument("-d", "--domain", required=True, help="Target domain (example: example.com)")
    parser.add_argument("-o", "--output", help="Output file path (default: <domain>_subs.txt)")
    parser.add_argument("-f", "--format", choices=["text","json"], default="text", help="Output format")
    parser.add_argument("--threads", type=int, default=5, help="Max concurrent providers")
    parser.add_argument("--timeout", type=int, default=10, help="HTTP timeout seconds")
    parser.add_argument("--silent", action="store_true", help="Silent mode (less console output)")
    parser.add_argument("--version", action="store_true", help="Show version")
    args = parser.parse_args()

    if args.version:
        print("ntsSubfinder", VERSION)
        sys.exit(0)

    domain = norm_domain(args.domain)
    if not domain:
        print("Invalid domain")
        sys.exit(1)

    if not args.output:
        args.output = f"{domain}_subs.{'json' if args.format=='json' else 'txt'}"

    if not args.silent:
        print(f"{C.GREEN}[+]{C.RESET} Starting passive enumeration for {domain}")

    subs, details = gather(domain, threads=args.threads, timeout=args.timeout, silent=args.silent)

    # cleanup: only keep proper subdomains (end with domain)
    final = set()
    for s in subs:
        s = s.strip().lower()
        if s.endswith(domain):
            final.add(s)

    if not args.silent:
        print(f"{C.GREEN}[+]{C.RESET} Found {len(final)} unique subdomains")

    save_output(args.output, final, fmt=args.format)

    if not args.silent:
        print(f"{C.GREEN}[+]{C.RESET} Saved to {args.output}")

if __name__ == "__main__":
    main()
